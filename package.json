{
  "name": "rasta",
  "version": "1.0.0",
  "description": "Right-to-left reading for AI agent apps on macOS, with automatic text direction, per-reply controls, and custom typography.",
  "type": "module",
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "test:language": "node --test test/language-policy.test.js",
    "test:codex-browser": "node test/codex-browser-smoke.mjs",
    "test:codex-content": "node test/codex-content-smoke.mjs",
    "test:message-directions": "node test/message-directions-smoke.mjs",
    "test:codex-native": "node test/codex-native-smoke.mjs",
    "test:gui": "node test/gui-electron-smoke.mjs && node test/font-electron-smoke.mjs",
    "test:installer": "node test/gui-job-smoke.mjs",
    "test:design": "node test/ui-design-smoke.mjs",
    "test:fonts": "node test/font-controls-smoke.mjs",
    "preview:design": "node tools/preview-design.mjs",
    "build:gui": "node tools/build-gui.mjs",
    "release:manifest": "node tools/release-manifest.mjs",
    "test:t3-design": "node test/t3-design-smoke.mjs",
    "clean": "node tools/clean.mjs",
    "test:codex-recovery": "node test/codex-recovery-smoke.mjs",
    "build:manager": "node tools/build-manager.mjs",
    "build:dmg": "node tools/build-manager-dmg.mjs",
    "test:manager-production": "node test/manager-production-smoke.mjs",
    "test:connection-panel": "node test/connection-panel-smoke.mjs",
    "test:manager-ui": "node test/manager-react-smoke.mjs",
    "preview:manager": "node tools/preview-manager.mjs",
    "inspect:desktop": "node tools/inspect-desktop-hosts.mjs",
    "test:desktop": "node --test test/desktop-connections.test.js test/desktop-bridge.test.js && node test/desktop-electron-smoke.mjs",
    "inspect:google": "node tools/inspect-google-hosts.mjs",
    "test:antigravity": "node --test test/google-apps.test.js test/antigravity-bridge.test.js && node test/antigravity-electron-smoke.mjs",
    "test:gemini": "node --test test/macho-loader.test.js && node tools/probe-gemini-text.mjs && node test/gemini-swiftui-smoke.mjs && node test/gemini-native-smoke.mjs",
    "test:manager-legacy-ui": "node test/manager-ui-smoke.mjs",
    "build:panel-ui": "npm --prefix ui/manager run build -- --mode panel",
    "build:manager-ui": "npm --prefix ui/manager run build",
    "security:check": "node tools/security-check.mjs",
    "test:security": "node --test --test-concurrency=1 test/update-feed.test.js test/connection-engine.test.js test/gui-updates.test.js test/gui-uninstall.test.js test/manager-core-update.test.js test/codex-native.test.js test/desktop-connections.test.js test/desktop-bridge.test.js test/host-bridge.test.js test/antigravity-bridge.test.js test/installer-architecture.test.js test/support-migration.test.js test/development-release.test.js",
    "release:check": "node tools/release-check.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "keywords": [
    "rasta",
    "ai-agents",
    "codex",
    "t3-code",
    "t3code",
    "rtl",
    "right-to-left",
    "persian",
    "farsi",
    "arabic",
    "hebrew",
    "macos",
    "typography"
  ],
  "license": "MIT",
  "files": [
    "bin",
    "docs",
    "README.md",
    "LICENSE",
    "CONTRIBUTING.md"
  ],
  "dependencies": {
    "@electron/asar": "^4.3.2",
    "fast-xml-parser": "^5.12.1"
  },
  "devDependencies": {
    "electron": "42.11.18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amirmahdinezhad/rasta.git"
  },
  "homepage": "https://github.com/amirmahdinezhad/rasta#readme",
  "bugs": {
    "url": "https://github.com/amirmahdinezhad/rasta/issues"
  }
}
